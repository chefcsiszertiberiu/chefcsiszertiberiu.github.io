# Copy this file to .env and fill in the real values.
# .env is git-ignored — never commit it.

# GitHub account that owns the Pages repository.
GH_OWNER=chefcsiszertiberiu
GH_REPO=chefcsiszertiberiu.github.io

# Fine-grained personal access token for the account above.
# Create it at https://github.com/settings/personal-access-tokens/new
#   Resource owner:      chefcsiszertiberiu
#   Repository access:   Only select repositories -> chefcsiszertiberiu.github.io
#   Repository permissions:
#     Contents        Read and write   (required to push)
#     Workflows       Read and write   (required because the repo has .github/workflows)
#     Pages           Read and write   (only if you want to configure Pages via API)
#   Expiration:          90 days
GH_TOKEN=
